flowchart TD
  A[Start: Align.align] --> B[AlignmentParameters.load_params_from_file]
  B --> B1[Extract len_seq_a and len_seq_b from sequences]
  B1 --> C[Align.populate_score_matrices]

  subgraph Init [Initialize Matrices]
    direction TB
    C --> D[Compute sizes: rows = len_seq_a + 1, cols = len_seq_b + 1]
    D --> E[Create m_matrix, ix_matrix, iy_matrix: numpy arrays rows x cols]
    E --> F[Create pointer matrices: m_matrix_pointers, ix_matrix_pointers, iy_matrix_pointers dtype=object]
    F --> G[Initialize all matrices: first row and first col = 0.0]
  end

  G --> J{Traverse cells: row 1 to len_seq_a, col 1 to len_seq_b}

  subgraph UpdateCell [Update Cell: update row col]
    direction TB
    J --> K[update_m: M i j]
    K --> K0["score_M = M[i-1,j-1] + s(xi,yj)<br/>score_Ix = Ix[i-1,j-1] + s(xi,yj)<br/>score_Iy = Iy[i-1,j-1] + s(xi,yj)<br/>max_score = max(score_M, score_Ix, score_Iy)"]
    K0 --> K1{Global or Local?}
    K1 -->|Local| K2["M[i,j] = max(0, max_score)"]
    K1 -->|Global| K3["M[i,j] = max_score"]
    K2 --> K4["Store pointers: [matrix_name, i-1, j-1]<br/>e.g. [M, i-1, j-1] or [Ix, i-1, j-1]"]
    K3 --> K4
    
    K4 --> L[update_ix: Ix i j gap in seq B]
    L --> L0["score_M = M[i-1,j] - dy<br/>score_Ix = Ix[i-1,j] - ey<br/>max_score = max(score_M, score_Ix)"]
    L0 --> L1{Global or Local?}
    L1 -->|Local| L2["Ix[i,j] = max(0, max_score)"]
    L1 -->|Global| L3["Ix[i,j] = max_score"]
    L2 --> L4["Store pointers: [matrix_name, i-1, j]<br/>e.g. [M, i-1, j] or [Ix, i-1, j]"]
    L3 --> L4
    
    L4 --> M[update_iy: Iy i j gap in seq A]
    M --> M0["score_M = M[i,j-1] - dx<br/>score_Iy = Iy[i,j-1] - ex<br/>max_score = max(score_M, score_Iy)"]
    M0 --> M1{Global or Local?}
    M1 -->|Local| M2["Iy[i,j] = max(0, max_score)"]
    M1 -->|Global| M3["Iy[i,j] = max_score"]
    M2 --> M4["Store pointers: [matrix_name, i, j-1]<br/>e.g. [M, i, j-1] or [Iy, i, j-1]"]
    M3 --> M4
  end

  M4 --> Q{More cells to process?}
  Q -->|Yes| J
  Q -->|No| R[find_traceback_start: Find optimal start positions]
  
  R --> S[traceback: Enumerate all optimal paths using pointer matrices]
  S --> T[write_output: Output best score and alignments]
  T --> U[End]
